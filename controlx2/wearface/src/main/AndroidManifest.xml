<?xml version="1.0" encoding="utf-8"?>
<!--
    Watch face services are declared here, in the library's own manifest, rather than in :wear's.
    The manifest merger folds them into the app APK either way, and keeping them here means
    :wear/src/main/AndroidManifest.xml (an upstream file) never has to be touched at all.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Only for the Dot Matrix weather widget's own best-effort fetch (IP geolocation + a free
        weather lookup -- see WeatherFetcher.kt); no other part of this module touches the
        network. A normal (not dangerous) permission, so it needs no runtime prompt.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application>
        <service
            android:name="it.mattia.controlx2face.dotmatrix.DotMatrixWatchFaceService"
            android:exported="true"
            android:label="@string/wf_dot_matrix_name"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
                <category android:name="com.google.android.wearable.watchface.category.WATCH_FACE" />
            </intent-filter>

            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/wf_watch_face" />
            <meta-data
                android:name="com.google.android.wearable.watchface.preview"
                android:resource="@drawable/wf_preview_dot_matrix" />
            <meta-data
                android:name="com.google.android.wearable.watchface.preview_circular"
                android:resource="@drawable/wf_preview_dot_matrix" />
            <!--
                No wearableConfigurationAction: a three-round diagnostic isolation (each round
                differed from the working build by exactly one element) confirmed it, and only
                it, makes the picker on this device drop the face from its list entirely. With
                it declared, the face was undiscoverable everywhere (on-watch picker, companion
                app), even though the manifest, previews and renderer were otherwise byte-correct.
                Costs the system-supplied style/complication editor; there is no known workaround
                that keeps it. Do not re-add without re-verifying on real hardware first.
            -->
            <meta-data
                android:name="androidx.wear.watchface.MULTIPLE_INSTANCES_ALLOWED"
                android:value="true" />
        </service>

        <service
            android:name="it.mattia.controlx2face.data.FaceMessageListenerService"
            android:exported="true">
            <!--
                BIND_LISTENER (rather than separate MESSAGE_RECEIVED/DATA_CHANGED filters with
                per-path <data> elements) delivers every Data Layer event system-wide to this
                service; the service itself filters by path in onMessageReceived/onDataChanged.
                Switched from a MESSAGE_RECEIVED-only filter when onDataChanged (the threshold
                settings sync) was added, so one declaration covers both callbacks.
            -->
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.BIND_LISTENER" />
            </intent-filter>
        </service>
    </application>

</manifest>
